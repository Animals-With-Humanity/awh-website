{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/lalita.html",
      "destination": "/lalita",
      "permanent": true
    },
    {
      "source": "/pawse.html",
      "destination": "/pawse",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "pawse.awhbharat.org"
        }
      ],
      "destination": "/pawse"
    }
  ]
}

